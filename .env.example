# ==========================================
# Evidence-Based Triage System Configuration
# ==========================================

# 1. Main Agent Configuration (Reasoning & SWE agent, e.g., qwen3.5:9b)
MAIN_AGENT_URL=http://localhost:11434/v1
MAIN_AGENT_NAME=qwen3.5:9b
MAIN_AGENT_API_KEY=

# 2. Decisions Model Configuration (Fast decision maker, e.g., clef-flash)
DECISIONS_MODEL_URL=http://localhost:11435/v1
DECISIONS_MODEL_NAME=clef-flash
DECISIONS_MODEL_API_KEY=

# 3. SSH Remote Environment Configuration
# Used to spin up boilerplate environments and run Playwright/test instances
SSH_HOST=127.0.0.1
SSH_PORT=22
SSH_USER=ubuntu
SSH_KEY_PATH=~/.ssh/id_rsao
SSH_PASSWORD=
SSH_REMOTE_WORKDIR=/tmp/triage_workspace
SSH_TIMEOUT=30

# 4. Execution Mode
# "ssh" to run commands remotely via SSH shell (default)
# "local" for local development / testing fallback without an active SSH server
EXECUTION_MODE=ssh
